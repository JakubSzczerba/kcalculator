{% extends 'base.html.twig' %}
{% block title %}Kcalculator | Nutrition Journal{% endblock %}
{% block body_class %}public-homepage{% endblock %}

{% block body %}
    <section class="public-shell">
        <section class="page-card page-card--wide public-hero">
            <div class="public-hero__content">
                <p class="eyebrow">Nutrition Journal</p>
                <h1>Kalkulator kalorii, który prowadzi dzień zamiast tylko liczyć liczby.</h1>
                <p class="page-card__lead">
                    Zbieraj posiłki, kontroluj makro, porównuj spożycie z celem i przygotuj się na kolejne moduły:
                    pomiary, urządzenia i rekomendacje.
                </p>

                <div class="public-actions">
                    <a href="{{ path('registration') }}" class="primary-button">Załóż konto</a>
                    <a href="{{ path('login') }}" class="secondary-button">Mam już konto</a>
                </div>
            </div>

            <aside class="public-highlight">
                <span class="public-highlight__label">Status projektu</span>
                <strong>Iteracyjna przebudowa nutrition-tech</strong>
                <p>Nowy shell UI i `Meal Journal` są już wydzielane moduł po module bez big-bang rewrite.</p>
                <small>Autor projektu: Jakub Szczerba</small>
            </aside>
        </section>

        <section class="public-grid">
            <article class="feature-tile">
                <p class="eyebrow">01</p>
                <h2>Cel kaloryczny</h2>
                <p>Oblicz dzienny target i porównuj go z realnym spożyciem bez ręcznego przeliczania makro.</p>
            </article>

            <article class="feature-tile">
                <p class="eyebrow">02</p>
                <h2>Dziennik posiłków</h2>
                <p>Dodawaj, edytuj i usuwaj wpisy z jednego miejsca, z szybkim podglądem kalorii dla całego dnia.</p>
            </article>

            <article class="feature-tile">
                <p class="eyebrow">03</p>
                <h2>Trend i analiza</h2>
                <p>Łącz historię wagi, cele i spożycie w jeden rytm dnia zamiast przeskakiwać między ekranami.</p>
            </article>
        </section>

        <section class="page-card page-card--wide public-story">
            <header class="page-card__header">
                <div>
                    <p class="eyebrow">Jak to działa</p>
                    <h2>Krótki onboarding bez zbędnego tarcia</h2>
                </div>
            </header>

            <div class="public-steps">
                <article class="public-step">
                    <span>1</span>
                    <h3>Utwórz konto</h3>
                    <p>Startujesz od prostego profilu użytkownika i podstawowego dostępu do aplikacji.</p>
                </article>
                <article class="public-step">
                    <span>2</span>
                    <h3>Ustal preferencje</h3>
                    <p>Wyliczasz dzienny cel i makro, żeby dashboard miał realny punkt odniesienia.</p>
                </article>
                <article class="public-step">
                    <span>3</span>
                    <h3>Prowadź dziennik</h3>
                    <p>Dodajesz produkty, obserwujesz bilans dnia i budujesz bazę pod dalsze insighty.</p>
                </article>
            </div>
        </section>
    </section>
{% endblock %}
