{% extends 'base.html.twig' %}

{% block title %}{{ product.product }}{% endblock %}
{% block body_class %}product-details-page{% endblock %}

{% block body %}
    <section class="page-card product-details">
        <header class="page-card__header">
            <div>
                <p class="eyebrow">Dodaj wpis</p>
                <h1>{{ product.product|e }}</h1>
                <p class="page-card__lead">Ustaw typ posiłku i wielkość porcji. Wartości poniżej odnoszą się do 100 g produktu.</p>
            </div>
            <div class="product-hero-kcal">
                <strong>{{ product.energy|e }} kcal</strong>
                <span>na 100 g</span>
            </div>
        </header>

        <div class="product-details__layout">
            <div class="nutrition-facts">
                <article class="nutrition-facts__item">
                    <span>Białko</span>
                    <strong>{{ product.protein|e }} g</strong>
                </article>
                <article class="nutrition-facts__item">
                    <span>Tłuszcz</span>
                    <strong>{{ product.fat|e }} g</strong>
                </article>
                <article class="nutrition-facts__item">
                    <span>Węglowodany</span>
                    <strong>{{ product.carbo|e }} g</strong>
                </article>
            </div>

            <div class="form-card">
                {{ form_start(form) }}
                    <div class="form-field">
                        {{ form_label(form.Meals) }}
                        {{ form_widget(form.Meals, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(form.Grammage) }}
                        {{ form_widget(form.Grammage, {'attr': {'class': 'form-control form-control-lg'}}) }}
                    </div>
                    <button type="submit" class="primary-button">Dodaj do dziennika</button>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
{% endblock %}
