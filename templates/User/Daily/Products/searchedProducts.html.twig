{% extends 'base.html.twig' %}
{% block title %}Wyniki wyszukiwania{% endblock %}
{% block body_class %}daily-search-page{% endblock %}

{% block body %}
    <section class="page-card page-card--wide search-results-page">
        <header class="page-card__header">
            <div>
                <p class="eyebrow">Katalog produktów</p>
                <h1>Wyniki dla „{{ nameProduct }}”</h1>
                <p class="page-card__lead">Wybierz produkt, aby przejść do ustawienia porcji i dodać go do dziennika.</p>
            </div>
            {% if products %}
                <span class="stat-pill">{{ products|length }} wyników</span>
            {% endif %}
        </header>

        {% if products %}
            <div class="product-grid">
                {% for product in products %}
                    <a class="product-result-card" href="{{ path('addEntry', {id: product.id}) }}">
                        <div class="product-result-card__body">
                            <h2>{{ product.product|e }}</h2>
                            <p>Dodaj produkt do dziennika i wybierz wielkość porcji.</p>
                        </div>
                        <div class="product-result-card__meta">
                            <strong>{{ product.energy|e }} kcal</strong>
                            <span>na 100 g</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <h2>Brak wyników</h2>
                <p>Nie znaleziono produktu o nazwie „{{ nameProduct }}”. Spróbuj krótszej lub bardziej ogólnej frazy.</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
