{% extends 'base.html.twig' %}
{% block title %}Dziennik{% endblock %}
{% block body_class %}daily-index-page{% endblock %}

{% block body %}
    {% set dateOfEntry = dataTest is defined ? dataTest|date("d/m/Y") : "dzisiaj" %}
    {% set sections = [
        { title: 'Przekąski', entries: snack|default([]), total: snackcal|default(0) },
        { title: 'Śniadanie', entries: breakfast|default([]), total: breakcal|default(0) },
        { title: 'Drugie śniadanie', entries: lunch|default([]), total: lunchkcal|default(0) },
        { title: 'Obiad', entries: dinner|default([]), total: dinnerkcal|default(0) },
        { title: 'Podwieczorek', entries: tea|default([]), total: teakcal|default(0) },
        { title: 'Kolacja', entries: supper|default([]), total: supperkcal|default(0) }
    ] %}

    <section class="page-card page-card--wide daily-page">
        <header class="page-card__header">
            <div>
                <p class="eyebrow">Dziennik</p>
                <h1>{{ dateOfEntry }}</h1>
                <p class="page-card__lead">Przeglądaj wpisy z wybranego dnia i szybko przechodź do edycji albo usuwania pozycji.</p>
            </div>

            <form action="{{ path('showEntries') }}" method="POST" class="date-filter">
                <label for="date" class="date-filter__label">Wybierz dzień</label>
                <div class="date-filter__controls">
                    <input type="date" id="date" name="dataToCheckDaily" class="date-filter__input">
                    <button type="submit" name="dateCheck" class="secondary-button">Pokaż</button>
                </div>
            </form>
        </header>

        {% if entry|default([]) %}
            <div class="meal-grid">
                {% for section in sections %}
                    {% if section.entries %}
                        <article class="meal-card">
                            <header class="meal-card__header">
                                <div>
                                    <h2>{{ section.title }}</h2>
                                    <p>{{ section.entries|length }} wpisów</p>
                                </div>
                                <strong>{{ section.total|number_format }} kcal</strong>
                            </header>

                            <div class="meal-entry-list">
                                {% for mealEntry in section.entries %}
                                    {% for product in mealEntry.food %}
                                        <article class="meal-entry">
                                            <div class="meal-entry__content">
                                                <h3>{{ product.product|e }}</h3>
                                                <p>{{ (mealEntry.grammage * 100)|number_format(0) }} g</p>
                                            </div>

                                            <div class="meal-entry__meta">
                                                <span class="meal-entry__kcal">{{ mealEntry.energyXgram|number_format }} kcal</span>
                                                <div class="meal-entry__actions">
                                                    <a href="{{ path('editEntry', {id: mealEntry.id}) }}">Edytuj</a>
                                                    <a
                                                        href="{{ path('deleteEntry', {id: mealEntry.id}) }}"
                                                        data-confirm="Czy na pewno chcesz usunąć ten wpis?"
                                                    >Usuń</a>
                                                </div>
                                            </div>
                                        </article>
                                    {% endfor %}
                                {% endfor %}
                            </div>
                        </article>
                    {% endif %}
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state empty-state--large">
                <h2>Brak wpisów dla {{ dateOfEntry }}</h2>
                <p>Dodaj pierwszy produkt z wyszukiwarki w górnym pasku albo sprawdź inny dzień.</p>
            </div>
        {% endif %}
    </section>
{% endblock %}

