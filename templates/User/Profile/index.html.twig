{% extends 'base.html.twig' %}
{% block title %}Profil{% endblock %}
{% block body_class %}profile-page{% endblock %}

{% block body %}
    {% set userProfile = profile|first %}

    <section class="profile-shell">
        <header class="page-card page-card--wide profile-hero">
            <div class="profile-hero__identity">
                <img src="{{ asset('build/images/nonavatar.jpg') }}" alt="Avatar użytkownika" class="profile-avatar">
                <div>
                    <p class="eyebrow">Profil</p>
                    <h1>{{ app.user.username }}</h1>
                    <p class="page-card__lead">
                        {% if userProfile %}
                            Dane konta i aktualny profil metaboliczny w jednym miejscu.
                        {% else %}
                            Konto jest aktywne, ale preferencje żywieniowe nie zostały jeszcze uzupełnione.
                        {% endif %}
                    </p>
                </div>
            </div>

            <div class="profile-hero__actions">
                <a href="{{ path('showEntries') }}" class="secondary-button">Otwórz dziennik</a>
                {% if userProfile %}
                    <a href="{{ path('editPreferentions', {id: userProfile.id}) }}" class="primary-button">Edytuj preferencje</a>
                {% else %}
                    <a href="{{ path('preferention') }}" class="primary-button">Ustaw preferencje</a>
                {% endif %}
            </div>
        </header>

        {% if userProfile %}
            <section class="profile-grid">
                <article class="page-card profile-card profile-card--summary">
                    <header class="profile-card__header">
                        <div>
                            <p class="eyebrow">Konto</p>
                            <h2>Podstawowe dane</h2>
                        </div>
                    </header>

                    <dl class="profile-detail-list">
                        <div>
                            <dt>Nazwa użytkownika</dt>
                            <dd>{{ userProfile.username|e }}</dd>
                        </div>
                        <div>
                            <dt>Email</dt>
                            <dd>{{ userProfile.email|e }}</dd>
                        </div>
                        <div>
                            <dt>Płeć</dt>
                            <dd>{{ ('preferentions.' ~ userProfile.gender)|trans|e }}</dd>
                        </div>
                        <div>
                            <dt>Wiek</dt>
                            <dd>{{ userProfile.age|e }}</dd>
                        </div>
                    </dl>
                </article>

                <article class="page-card profile-card">
                    <header class="profile-card__header">
                        <div>
                            <p class="eyebrow">Parametry</p>
                            <h2>Masa i wzrost</h2>
                        </div>
                    </header>

                    <div class="profile-metric-grid">
                        <div class="metric-card">
                            <span>Waga</span>
                            <strong>{{ userProfile.weight|e }}</strong>
                            <small>kg</small>
                        </div>
                        <div class="metric-card">
                            <span>Wzrost</span>
                            <strong>{{ userProfile.height|e }}</strong>
                            <small>cm</small>
                        </div>
                    </div>
                </article>

                <article class="page-card page-card--wide profile-card">
                    <header class="profile-card__header">
                        <div>
                            <p class="eyebrow">Plan</p>
                            <h2>Profil żywieniowy</h2>
                        </div>
                    </header>

                    <div class="profile-plan-grid">
                        <div class="metric-card metric-card--brand">
                            <span>Dzienne kcal</span>
                            <strong>{{ userProfile.kcal_day|e }}</strong>
                            <small>cel dzienny</small>
                        </div>
                        <div class="metric-card">
                            <span>BMR</span>
                            <strong>{{ userProfile.caloric_requirement|e }}</strong>
                            <small>kcal bazowe</small>
                        </div>
                        <div class="metric-card">
                            <span>Aktywność</span>
                            <strong>{{ ('preferentions.' ~ userProfile.activity)|trans|e }}</strong>
                            <small>wybrany poziom</small>
                        </div>
                        <div class="metric-card">
                            <span>Intencja</span>
                            <strong>{{ ('preferentions.' ~ userProfile.intentions)|trans|e }}</strong>
                            <small>aktualny kierunek</small>
                        </div>
                    </div>

                    <div class="macro-summary-grid profile-macro-grid">
                        <div class="macro-summary macro-summary--protein">
                            <span>Białko</span>
                            <strong>{{ userProfile.proteinPerDay|e }}</strong>
                            <small>g / dzień</small>
                        </div>
                        <div class="macro-summary macro-summary--fat">
                            <span>Tłuszcz</span>
                            <strong>{{ userProfile.fatPerDay|e }}</strong>
                            <small>g / dzień</small>
                        </div>
                        <div class="macro-summary macro-summary--carbs">
                            <span>Węglowodany</span>
                            <strong>{{ userProfile.carboPerDay|e }}</strong>
                            <small>g / dzień</small>
                        </div>
                    </div>
                </article>
            </section>
        {% else %}
            <section class="page-card empty-state empty-state--large">
                <h2>Profil jest jeszcze niekompletny</h2>
                <p>Dodaj preferencje żywieniowe, żeby zobaczyć cele, makroskładniki i dane metaboliczne na profilu.</p>
                <a href="{{ path('preferention') }}" class="primary-button">Uzupełnij preferencje</a>
            </section>
        {% endif %}
    </section>
{% endblock %}
