{% extends 'base.html.twig' %}
{% block title %}Panel główny{% endblock %}
{% block body_class %}dashboard-page{% endblock %}

{% block body %}
    {% set preference = preferentions|first %}
    {% set calorieTarget = preference.kcal_day|default(0) %}
    {% set caloriesLeft = calorieTarget - summKcal %}

    <section class="dashboard-shell">
        <header class="page-card page-card--wide dashboard-hero">
            <div>
                <p class="eyebrow">Panel główny</p>
                <h1>Dzisiejszy obraz dnia</h1>
                <p class="page-card__lead">Szybki przegląd kalorii, makroskładników i trendu wagi bez skakania między ekranami.</p>
            </div>

            {% if preference %}
                <div class="dashboard-hero__balance">
                    <span>Pozostało</span>
                    <strong>{{ caloriesLeft|number_format }} kcal</strong>
                    <small>z celu {{ calorieTarget|number_format }} kcal</small>
                </div>
            {% else %}
                <a href="{{ path('preferention') }}" class="primary-button dashboard-hero__cta">Ustaw preferencje</a>
            {% endif %}
        </header>

        {% if preference %}
            <section class="dashboard-metrics">
                <article class="metric-card metric-card--brand">
                    <span>Dzisiejsze spożycie</span>
                    <strong>{{ summKcal|number_format }}</strong>
                    <small>kcal zjedzone dzisiaj</small>
                </article>
                <article class="metric-card">
                    <span>Cel dzienny</span>
                    <strong>{{ calorieTarget|number_format }}</strong>
                    <small>{{ ('preferentions.' ~ preference.intentions)|trans }}</small>
                </article>
                <article class="metric-card">
                    <span>Białko</span>
                    <strong>{{ summProtein|number_format }}</strong>
                    <small>/ {{ preference.proteinPerDay|e }} g</small>
                </article>
                <article class="metric-card">
                    <span>Tłuszcz</span>
                    <strong>{{ summFat|number_format }}</strong>
                    <small>/ {{ preference.fatPerDay|e }} g</small>
                </article>
                <article class="metric-card">
                    <span>Węglowodany</span>
                    <strong>{{ summCarbo|number_format }}</strong>
                    <small>/ {{ preference.carboPerDay|e }} g</small>
                </article>
            </section>

            <section class="dashboard-grid">
                <article class="page-card dashboard-card">
                    <header class="dashboard-card__header">
                        <div>
                            <p class="eyebrow">Bilans</p>
                            <h2>Kalorie i cel</h2>
                        </div>
                    </header>

                    <div class="balance-equation">
                        <div class="balance-equation__item">
                            <span>Cel</span>
                            <strong>{{ calorieTarget|number_format }}</strong>
                        </div>
                        <span class="balance-equation__operator">-</span>
                        <div class="balance-equation__item">
                            <span>Spożycie</span>
                            <strong>{{ summKcal|number_format }}</strong>
                        </div>
                        <span class="balance-equation__operator">=</span>
                        <div class="balance-equation__item balance-equation__item--result">
                            <span>Pozostało</span>
                            <strong>{{ caloriesLeft|number_format }}</strong>
                        </div>
                    </div>

                    <dl class="dashboard-definition-list">
                        <div>
                            <dt>Wybrany cel</dt>
                            <dd>{{ ('preferentions.' ~ preference.intentions)|trans }}</dd>
                        </div>
                        <div>
                            <dt>Status dnia</dt>
                            <dd>
                                {% if caloriesLeft >= 0 %}
                                    Mieścisz się w planie
                                {% else %}
                                    Przekroczono cel o {{ (caloriesLeft * -1)|number_format }} kcal
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                </article>

                <article class="page-card dashboard-card">
                    <header class="dashboard-card__header">
                        <div>
                            <p class="eyebrow">Makroskładniki</p>
                            <h2>Rozkład makro</h2>
                        </div>
                    </header>

                    <div class="macro-summary-grid">
                        <div class="macro-summary macro-summary--protein">
                            <span>Białko</span>
                            <strong>{{ summProtein|number_format }}</strong>
                            <small>/ {{ preference.proteinPerDay|e }} g</small>
                        </div>
                        <div class="macro-summary macro-summary--fat">
                            <span>Tłuszcz</span>
                            <strong>{{ summFat|number_format }}</strong>
                            <small>/ {{ preference.fatPerDay|e }} g</small>
                        </div>
                        <div class="macro-summary macro-summary--carbs">
                            <span>Węglowodany</span>
                            <strong>{{ summCarbo|number_format }}</strong>
                            <small>/ {{ preference.carboPerDay|e }} g</small>
                        </div>
                    </div>

                    <div class="chart-panel chart-panel--compact">
                        {{ render_chart(chartMacro) }}
                    </div>
                </article>

                <article class="page-card page-card--wide dashboard-card">
                    <header class="dashboard-card__header">
                        <div>
                            <p class="eyebrow">Trend</p>
                            <h2>Historia wagi</h2>
                        </div>
                    </header>

                    <div class="chart-panel chart-panel--wide">
                        {{ render_chart(chartWeight) }}
                    </div>
                </article>
            </section>
        {% else %}
            <section class="page-card empty-state empty-state--large">
                <h2>Brakuje preferencji użytkownika</h2>
                <p>Ustaw podstawowe dane i cel żywieniowy, żeby uruchomić dashboard kalorii, makro i trendów.</p>
                <a href="{{ path('preferention') }}" class="primary-button">Oblicz zapotrzebowanie</a>
            </section>
        {% endif %}
    </section>
{% endblock %}
