<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-beta.3/css/bootstrap.min.css"
          integrity="sha384-Zug+QiDoJOrZ5t4lssLdxGhVrurbmBWopoEl+M6BdEfwnCJZtKxi1KgxUyJq13dy"
          crossorigin="anonymous">

    <title>{% block title %}Kcalculator{% endblock %}</title>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="{% if app.user %}has-sidebar{% endif %} {% block body_class %}{% endblock %}">
<div class="app-shell">
    <header class="topbar">
        <div class="topbar__inner">
            <div class="topbar__brand-group">
                {% if app.user %}
                    <button type="button" class="icon-button mobile-only" data-sidebar-toggle aria-label="Przełącz menu">
                        <ion-icon name="menu-sharp"></ion-icon>
                    </button>
                    <a class="brand-link" href="{{ path('dashboard') }}">
                        <img class="brand-link__logo" src="{{ asset('build/images/logo.png') }}" alt="Kcalculator">
                    </a>
                {% else %}
                    <a class="brand-link" href="{{ path('home') }}">
                        <img class="brand-link__logo" src="{{ asset('build/images/logo.png') }}" alt="Kcalculator">
                    </a>
                {% endif %}
            </div>

            {% if app.user %}
                <form action="{{ path('findFood') }}" method="POST" class="topbar-search" role="search">
                    <label class="sr-only" for="product-search">Wyszukaj produkt</label>
                    <input
                        id="product-search"
                        type="search"
                        name="search"
                        class="topbar-search__input"
                        placeholder="Wpisz nazwę produktu, aby dodać go do dziennika"
                        aria-label="Wyszukaj produkt"
                    >
                    <button class="topbar-search__button" type="submit">Szukaj</button>
                </form>

                <nav class="topbar-actions" aria-label="Akcje użytkownika">
                    <button type="button" class="icon-button" data-theme-toggle aria-label="Przełącz motyw">
                        <ion-icon name="contrast-sharp"></ion-icon>
                    </button>
                    <a class="icon-button" href="{{ path('profile') }}" aria-label="Profil użytkownika">
                        <ion-icon name="person-circle-sharp"></ion-icon>
                    </a>
                </nav>
            {% else %}
                <nav class="topbar-public-nav" aria-label="Nawigacja główna">
                    <a href="{{ path('home') }}">Strona główna</a>
                    <a href="{{ path('login') }}">Zaloguj się</a>
                    <a href="{{ path('registration') }}">Zarejestruj się</a>
                </nav>
            {% endif %}
        </div>
    </header>

    {% if app.user %}
        <aside class="sidebar" data-sidebar>
            <div class="sidebar__header">
                <span class="sidebar__eyebrow">Nawigacja</span>
                <button type="button" class="icon-button desktop-only" data-sidebar-toggle aria-label="Zwiń menu">
                    <ion-icon name="chevron-back-sharp"></ion-icon>
                </button>
            </div>

            <nav class="sidebar__nav" aria-label="Główne menu">
                <a class="sidebar__link" href="{{ path('dashboard') }}">
                    <ion-icon name="home-sharp"></ion-icon>
                    <span>Panel główny</span>
                </a>
                <a class="sidebar__link" href="{{ path('showEntries') }}">
                    <ion-icon name="calendar-number-sharp"></ion-icon>
                    <span>Dziennik</span>
                </a>
                <a class="sidebar__link" href="{{ path('profile') }}">
                    <ion-icon name="person-sharp"></ion-icon>
                    <span>{{ app.user.username }}</span>
                </a>
                <a class="sidebar__link" href="{{ path('showEntries') }}">
                    <ion-icon name="pie-chart-sharp"></ion-icon>
                    <span>Analiza</span>
                </a>
                <a class="sidebar__link" href="{{ path('logout') }}">
                    <ion-icon name="log-out-sharp"></ion-icon>
                    <span>Wyloguj się</span>
                </a>
            </nav>
        </aside>
    {% endif %}

    <main class="page-shell">
        <div class="page-shell__inner">
            {% for type, messages in app.session.flashbag.all() %}
                {% for message in messages %}
                    <div class="flash-message flash-message--{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>
    </main>
</div>
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</body>
</html>
